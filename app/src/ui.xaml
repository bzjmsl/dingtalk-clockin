<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWin"
        Title="钉钉打卡助手"
        Width="1100" Height="720"
        MinWidth="960" MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Dot" Width="4" Height="16" CornerRadius="2" Background="Transparent" Margin="0,0,10,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Line}" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,0" Width="260">
                            <StackPanel>
                                <TextBlock x:Name="T1" Text="{TemplateBinding Tag}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <ContentPresenter Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="32" CornerRadius="8" Padding="14,0"
                                Background="{DynamicResource BgAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Line}" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="6" Background="{DynamicResource Accent}"/>
                    <TextBlock Text="钉钉打卡助手" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitleHint" Text="常驻托盘 · 工作日自动执行" Margin="12,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="BtnMin" Content="—" Style="{StaticResource ChromeButton}"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource ChromeButton}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgAlt}" CornerRadius="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="14,10,14,0">
                            <RadioButton x:Name="NavOverview" Content="概览" IsChecked="True" Style="{StaticResource NavItem}"/>
                            <RadioButton x:Name="NavSettings" Content="打卡设置" Style="{StaticResource NavItem}"/>
                            <RadioButton x:Name="NavHoliday" Content="节假日" Style="{StaticResource NavItem}"/>
                            <RadioButton x:Name="NavLogs" Content="日志与截图" Style="{StaticResource NavItem}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="18,0,18,16">
                            <TextBlock x:Name="TxtSideStatus" Text="未连接设备" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="TxtVersion" Text="v1.0 · ADB" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="20,4,20,16">

                    <!-- ============ 概览 ============ -->
                    <Grid x:Name="PageOverview">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="概览" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="手机状态" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="型号" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="TxtDeviceModel" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="序列号" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="TxtDeviceSerial" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="电量 / 连接" Style="{StaticResource Label}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="TxtBattery" Text="—" Style="{StaticResource Value}"/>
                                                    <TextBlock x:Name="TxtConnState" Text="未连接" Style="{StaticResource Value}"
                                                               Foreground="{DynamicResource Danger}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="3" x:Name="BtnRefreshDevice" Content="刷新" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                <TextBlock Text="定位" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="TxtLocation" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                                <TextBlock Text="网络" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="TxtNetwork" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                                <TextBlock Text="电源监控" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="TxtPowerEvent" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="下次执行" Style="{StaticResource CardTitle}" Margin="0,0,10,0"/>
                                                <Border x:Name="BadgeMode" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtModeBadge" Text="极速打卡" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtNextRun" Text="—" FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtCountdown" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnTogglePause" Content="暂停" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnRunNow" Content="立即试跑" Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="今日判定" Style="{StaticResource CardTitle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtTodayState" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtTodayReason" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="12,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="最近一次结果" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="TxtLastResult" Text="还没有执行记录" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        <Image x:Name="ImgLastShot" Height="220" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,10,0,0"
                                               Cursor="Hand" ToolTip="点击查看大图"/>
                                        <TextBlock Text="点击图片可查看原图" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" x:Name="TxtToast" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- ============ 设置 ============ -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="打卡设置" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="打卡方式" Style="{StaticResource CardTitle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbModeWake" Tag="极速打卡" IsChecked="True" Style="{StaticResource ModeCard}" GroupName="Mode">
                                                <TextBlock Text="唤醒解锁并打开钉钉，由极速打卡完成，不点任何按钮" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </RadioButton>
                                            <RadioButton x:Name="RbModeFull" Tag="手动点击" Style="{StaticResource ModeCard}" GroupName="Mode">
                                                <TextBlock Text="进入打卡页并点击打卡按钮，可识别内勤/外勤" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </RadioButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="时间窗口（在区间内随机取时刻）" Style="{StaticResource CardTitle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="上班" Style="{StaticResource Label}" VerticalAlignment="Center" Width="40"/>
                                            <TextBox x:Name="TxtMorningStart" Width="88" Style="{StaticResource InputBox}"/>
                                            <TextBlock Text="—" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBox x:Name="TxtMorningEnd" Width="88" Style="{StaticResource InputBox}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="下班" Style="{StaticResource Label}" VerticalAlignment="Center" Width="40"/>
                                            <TextBox x:Name="TxtEveningStart" Width="88" Style="{StaticResource InputBox}"/>
                                            <TextBlock Text="—" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBox x:Name="TxtEveningEnd" Width="88" Style="{StaticResource InputBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="行为选项" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <CheckBox x:Name="ChkAutostart" Content="开机自动启动（当前用户）" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkOpenApp" Content="极速打卡模式下自动打开钉钉界面" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkAbortField" Content="检测到外勤打卡（绿色按钮）时中止" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <CheckBox x:Name="ChkScreenshots" Content="保存打卡截图（关闭后不写入磁盘）" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkPreflight" Content="打卡前检查定位与网络" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkNotifications" Content="显示托盘通知（打卡结果、失败与异常）" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkPowerMonitor" Content="后台记录手机电量（用于排查自动关机）" Style="{StaticResource Switch}" Margin="0,0,0,14"/>
                                                <CheckBox x:Name="ChkSkipMissed" Content="错过时间窗口则跳过（不补打）" Style="{StaticResource Switch}" IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="锁屏密码与 ADB" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="锁屏密码" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <PasswordBox x:Name="PwdPin" Grid.Column="1" Style="{StaticResource InputPassword}"/>
                                            <TextBlock Grid.Column="2" Text="  ADB 路径" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="24,0,10,0"/>
                                            <TextBox x:Name="TxtAdbPath" Grid.Column="3" Style="{StaticResource InputBox}"/>
                                            <Button Grid.Column="4" x:Name="BtnTestAdb" Content="测试连接" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkLight" Content="使用浅色主题" Style="{StaticResource Switch}" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnSaveSettings" Content="保存设置" Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="BtnReset" Content="恢复默认" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TxtSettingsHint" Text="" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 节假日 ============ -->
                    <Grid x:Name="PageHoliday" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="节假日与调休" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSyncYear" Content="联网同步本年" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnImportCsv" Content="导入 CSV" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                    <Button x:Name="BtnImportJson" Content="导入 JSON" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                    <Button x:Name="BtnExport" Content="导出 CSV" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="日期" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtHolidayDate" Width="120" Style="{StaticResource InputBox}" ToolTip="格式 2026-10-01"/>
                                    <RadioButton x:Name="RbTypeHoliday" Content="节假日" GroupName="HolidayType" IsChecked="True"
                                                 Style="{StaticResource PillRadio}" Margin="12,0,0,0"/>
                                    <RadioButton x:Name="RbTypeWorkday" Content="调休上班" GroupName="HolidayType"
                                                 Style="{StaticResource PillRadio}" Margin="8,0,0,0"/>
                                    <TextBlock Text="名称" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <TextBox x:Name="TxtHolidayName" Width="180" Style="{StaticResource InputBox}" ToolTip="名称，可留空"/>
                                    <Button x:Name="BtnAddHoliday" Content="添加" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                                    <Button x:Name="BtnDeleteHoliday" Content="删除选中" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="TxtHolidayHint" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="日期" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource Label}"/>
                                </Grid>
                                <ListBox x:Name="LstHolidays" Grid.Row="1" Style="{StaticResource FlatList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="13" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SourceText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 日志 ============ -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="日志与截图" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnOpenFolder" Content="打开数据目录" Style="{StaticResource GhostButton}"/>
                            <Button x:Name="BtnDeleteShot" Content="删除选中截图" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                            <Button x:Name="BtnClearShots" Content="清空全部截图" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TxtLogHint" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,0,0"
                                       MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <ListBox x:Name="LstLogs" Style="{StaticResource FlatList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="最近截图" Style="{StaticResource CardTitle}"/>
                                    <ListBox x:Name="LstShots" Grid.Row="1" Style="{StaticResource FlatList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Image x:Name="ImgShotPreview" Grid.Row="2" Stretch="Uniform" Margin="0,10,0,0" Cursor="Hand" ToolTip="点击查看大图"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
